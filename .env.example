# Default local quickstart: instance/parking.db (SQLite).
# MySQL option (not yet integration-tested):
# DATABASE_URL=mysql+pymysql://parking_user:ENCODED_PASSWORD@127.0.0.1/campus_parking
CAMPUS_TIMEZONE=America/New_York
# Set a unique random SECRET_KEY before shared or deployed use.
# APP_HTTPS=1 enables Secure cookies when HTTPS is configured.
# Production also requires APP_ENV=production, a random persistent SECRET_KEY
# of at least 32 characters, and TRUSTED_HOSTS=your-exact-hostname.
# Store the database on a persistent volume. Never deploy the local demo DB.

